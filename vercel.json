{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(og-image\\.png|apple-touch-icon\\.png|favicon\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; sandbox" }
      ]
    },
    {
      "source": "/((?!api/|api$).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "(?:dev\\..*|.*\\.vercel\\.app)" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__ma_path=/api/$1" },
    { "source": "/favicon.svg", "destination": "/api?__ma_path=/favicon.svg" },
    { "source": "/((?!assets/|api/|api$|favicon\\.svg|robots\\.txt|sitemap\\.xml|llms\\.txt|manifest\\.webmanifest|og-image\\.png|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ]
}
