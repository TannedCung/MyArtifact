# ==============================================================================
# MyArtifact Cloud — Environment Variables (Vercel Hobby $0/mo & Self-Hosted)
# ==============================================================================

# ------------------------------------------------------------------------------
# Required on Vercel Hobby Serverless Deployment
# ------------------------------------------------------------------------------
# Serverless PostgreSQL connection string (e.g. Neon Free Tier pooled URL `-pooler`)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Single master secret used to deterministically derive ES256 JWT signing keys,
# session cookie HMAC keys, and signed blob upload/download URLs across cold starts.
# Generate with: openssl rand -hex 32
MYARTIFACT_SECRET=replace-with-64-hex-chars-from-openssl-rand

# Google OAuth 2.0 / OIDC Web Application credentials
# Authorized redirect URI: https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Optional Configuration
# ------------------------------------------------------------------------------
# Explicit canonical public URL (auto-detected from X-Forwarded-Proto/Host if omitted)
# MYARTIFACT_PUBLIC_URL=https://myartifact.vercel.app

# Restrict login/workspace features or customize JWT issuer / Postgres pool size
# MYARTIFACT_JWT_ISSUER=myartifact-cloud
# PG_POOL_MAX=3

# Optional Cloudflare R2 / S3 / GCS storage for >4.5 MB model checkpoints
# (When omitted on Vercel, artifact text & small objects fall back to Postgres `cloud_blobs`)
# MYARTIFACT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MYARTIFACT_S3_REGION=auto
# MYARTIFACT_S3_BUCKET=myartifact-blobs
# MYARTIFACT_S3_ACCESS_KEY=your-r2-access-key-id
# MYARTIFACT_S3_SECRET_KEY=your-r2-secret-access-key
# MYARTIFACT_S3_FORCE_PATH_STYLE=true
