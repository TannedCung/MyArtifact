{
  "name": "myartifact",
  "version": "1.0.0",
  "description": "Local-first, private, cross-assistant visual artifact studio & MCP server for Claude Code, OpenAI Codex, and Google Antigravity",
  "license": "MIT",
  "author": "TannedCung <tando1903@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannedCung/MyArtifact.git"
  },
  "homepage": "https://github.com/TannedCung/MyArtifact#readme",
  "bugs": {
    "url": "https://github.com/TannedCung/MyArtifact/issues"
  },
  "keywords": [
    "artifacts",
    "claude-artifacts",
    "claude-code",
    "codex",
    "antigravity",
    "mcp",
    "model-context-protocol",
    "react-sandbox",
    "mermaid",
    "local-first",
    "ai-coding-assistant"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "myartifact": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch src/cli/cli.ts serve",
    "build:web": "vite build",
    "build:server": "tsup src/cli/cli.ts src/mcp/mcp-server.ts src/index.ts --format esm --target node22 --out-dir dist --external pg --clean",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/cli/cli.js serve",
    "mcp": "node dist/cli/cli.js mcp",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.7",
    "mermaid": "^11.6.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
